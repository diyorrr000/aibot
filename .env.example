# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyZ

# Gemini API Key from aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Admin User IDs (comma-separated list of Telegram user IDs)
ADMIN_IDS=7306854093

# Default AI Model (claude, grok, gpt, gemini-2.5-flash-lite)
DEFAULT_MODEL=claude

# Rate limit seconds per user
RATE_LIMIT_SECONDS=1.5

# Max conversation history length
MAX_HISTORY_LENGTH=20

# Web server port for Render/health check
PORT=3000

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
